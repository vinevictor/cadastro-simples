// Prisma schema — banco de dados Postgres (Prisma Postgres / Vercel Storage)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AgeGroup {
  id     String  @id @default(cuid())
  label  String? // nome opcional, ex: "Pré-adolescentes"
  minAge Int
  maxAge Int
  color  String // cor em hexadecimal, ex: "#8B5CF6"

  children Child[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([minAge, maxAge])
}

model Child {
  id String @id @default(cuid())

  // Dados da criança
  name      String
  birthDate DateTime

  // Grupo por faixa etária (sugerido automaticamente, mas pode ser trocado)
  ageGroupId String?
  ageGroup   AgeGroup? @relation(fields: [ageGroupId], references: [id], onDelete: SetNull)

  // Responsáveis
  motherName String
  fatherName String?
  phones     String // telefones de contato, separados por vírgula

  // Servço/equipe dos pais no encontro
  team String?

  // Saúde
  hasAllergy          Boolean @default(false)
  allergyDesc         String?
  takesMedication     Boolean @default(false)
  medicationDesc      String?
  hasDietRestriction  Boolean @default(false)
  dietRestrictionDesc String?

  // Alimentação e permanência
  willEat Boolean @default(true)
  days    String // dias que a criança ficará, separados por vírgula (ex: "Sexta,Sábado,Domingo")

  notes String? // observações relevantes

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}
